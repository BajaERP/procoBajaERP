# PostgreSQL
POSTGRES_DB=procobaja
POSTGRES_USER=procobaja
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# First Capitão, created on backend startup when there is no active Capitão.
# The password must have at least 8 characters; change it in Configurações after the first login.
PROCOBAJA_CAPITAO_INICIAL_RA=capitao
PROCOBAJA_CAPITAO_INICIAL_NOME=Capitão
PROCOBAJA_CAPITAO_INICIAL_SENHA=change-me-please

# Set to true when the backend is served over HTTPS.
PROCOBAJA_COOKIE_SEGURO=false

# Application ports
BACKEND_PORT=8080
FRONTEND_DEV_PORT=5173
FRONTEND_PROD_PORT=80

# pgAdmin (development only)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# Backup script defaults
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_WEEKS=4
