# PostgreSQL
POSTGRES_DB=procobaja
POSTGRES_USER=procobaja
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# First Capitão, created on backend startup when there is no active Capitão.
# Fill these only in your real .env: this file must never carry real credentials.
# While they are empty, the backend creates no Capitão and logs a warning.
# The password must have 8 to 64 characters. After the first login, change it in
# Configurações and remove it from .env.
PROCOBAJA_CAPITAO_INICIAL_RA=
PROCOBAJA_CAPITAO_INICIAL_NOME=
PROCOBAJA_CAPITAO_INICIAL_SENHA=

# Session and XSRF cookies marked Secure, sent by the browser only over HTTPS.
# compose.prod.yaml already uses true; development over http://localhost uses false.
# PROCOBAJA_COOKIE_SEGURO=true

# Application ports
BACKEND_PORT=8080
FRONTEND_DEV_PORT=5173
FRONTEND_PROD_PORT=80

# pgAdmin (development only)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# Backup script defaults
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_WEEKS=4
